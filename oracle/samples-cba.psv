# Oracle samples for the Blinter stack C/B/A (reviewer, 2026-11-02).
# Format: BRANCH | ID | WHAT IT PROBES -> OUTPUT THAT CONFIRMS THE REVIEW'S READING | SCRIPT
# SCRIPT is one batch file; "\n" separates its lines (write them with CRLF). Run as a .cmd file.
B | B-o1 | an escaped & after unquoted cmd /c separates commands in the child -> prints S003PROBE=1 | @cmd /c echo A ^& set S003PROBE=1 ^& set S003PROBE
B | B-o2 | an escaped & inside a FOR /F command string separates commands -> prints [S003PROBE=1] | @for /f "delims=" %%a in ('ver ^& set S003PROBE^=1 ^& set S003PROBE') do @echo [%%a]
B | B-o3 | escaped quotes around a cmd /c string still run both commands in the child -> prints S003PROBE=1 | @cmd /c ^"set S003PROBE=1 ^& set S003PROBE^"
B | B-o4 | %name with space% expands before IF reads its operands -> prints S003PROBE=1 | @set "my var=a"\n@if %my var% == a set S003PROBE=1\n@set S003PROBE
B | B-o5 | !comspec! as command name runs cmd.exe -> prints S003PROBE=1 | @setlocal enabledelayedexpansion\n@!comspec! /c set S003PROBE=1 ^& set S003PROBE
B | B-o6 | a caret-escaped space stays inside an IF EXIST operand -> prints S003PROBE=1 | @if exist C:\Program^ Files set S003PROBE=1\n@set S003PROBE
B | B-o7 | cmd.exe accepts glued switches /d/c -> prints S003PROBE=1 | @cmd /d/c set S003PROBE=1 ^& set S003PROBE
A | A-o1 | a block after || is skipped when the left side succeeds, so the next line runs with delayed expansion off -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nver >nul || (\n  exit /b 1\n)\necho [!A!]
A | A-o2 | a block opened with a command on the IF line and closed at the end of the last line is skipped as a whole -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nif "x"=="y" (echo bye\n  exit /b 1)\necho [!A!]
A | A-o3 | a caret at line end joins EXIT to the IF, so EXIT is conditional -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nif "x"=="y" ^\nexit /b 1\necho [!A!]
A | A-o4 | (if ... exit /b) is conditional -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\n(if exist C:\\no_such_dir_zz exit /b)\necho [!A!]
A | A-o5 | CALL %fn% with fn=:sub calls the label -> prints [!A!] SUB | @echo off\nset "fn=:sub"\ncall %fn%\nexit /b\n:sub\necho [!A!] SUB\nexit /b
A | A-o6 | GOTO with a duplicate label searches forward from the current line -> prints SECOND (FIRST means first-in-file) | @echo off\ngoto :main\n:x\necho FIRST\nexit /b 0\n:main\ngoto :x\necho unreachable\n:x\necho SECOND
A | A-o7 | whether "& cmd" after an IF's closing parenthesis belongs to the IF -> prints only END if it belongs to the IF, AFTER and END if not | @echo off\nif "x"=="y" (\n  echo then\n) & echo AFTER\necho END
A | A-o8 | whether GOTO strips quotes from its label -> prints END only if quotes are stripped; an error otherwise | @echo off\ngoto "end"\necho FELL\n:end\necho END
B | B-o8 | an unescaped parenthesis inside an unquoted cmd /c string leaves ^& live in the child -> prints A then S003PROBE=1 | @cmd /c (echo A) ^& set S003PROBE=1 ^& set S003PROBE
B | B-o9 | START of an internal command runs it in cmd /k, where ^& splits -> prints S003PROBE=1 | @start "" /b /wait set S003PROBE=1 ^& set S003PROBE <nul
B | B-o10 | a /c glued to its command is still cmd /c -> prints S003PROBE=1 | @cmd /cset S003PROBE=1 ^& set S003PROBE
B | B-o11 | table row: ^^^& after one cmd /c stays text in the child -> prints "A & set S003PROBE=1" and no S003PROBE=1 line | @cmd /c echo A ^^^& set S003PROBE=1
B | B-o12 | ^^^& after two cmd /c splits in the grandchild -> prints A then S003PROBE=1 | @cmd /c cmd /c echo A ^^^& set S003PROBE=1 ^^^& set S003PROBE
A | A-o9 | a label reached by a computed GOTO after ENDLOCAL runs with delayed expansion off -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset "A=1"\nendlocal\nset "t=next"\ngoto %t%\n:next\necho [!A!]
A | A-o10 | a line after a skipped || block, also reached by CALL -> prints [1] then [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset "A=1"\ncall :tail\nendlocal\nver >nul || (\n  exit /b 1\n)\n:tail\necho [!A!]\nexit /b 0
A | A-o11 | same after an IF block closed on its exit line -> prints [1] then [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset "A=1"\ncall :tail\nendlocal\nif "x"=="y" (echo bye\n  exit /b 1)\n:tail\necho [!A!]\nexit /b 0
A | A-o12 | same after a caret-continued IF -> prints [1] then [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset "A=1"\ncall :tail\nendlocal\nif "x"=="y" ^\nexit /b 1\n:tail\necho [!A!]\nexit /b 0
A | A-o13 | ELSE form: whether "& cmd" after ) of an ELSE block belongs to the ELSE -> prints else, AFTER, END if it does | @echo off\nif "x"=="y" (\n  echo then\n) else (\n  echo else\n) & echo AFTER\necho END
A | A-r1 | ELSE "& cmd" when the THEN branch runs -> prints then, END | @echo off\nif "x"=="x" (\n  echo then\n) else (\n  echo else\n) & echo AFTER\necho END
A | A-r2 | ENDLOCAL in THEN, "& exit /b" after ELSE -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nif "x"=="x" (\n  endlocal\n) else (\n  echo else\n) & exit /b\necho [!A!]
A | A-r3 | ELSE IF chain with "& cmd" after its last ) -> prints END | @echo off\nif "x"=="y" (\n  echo a\n) else if "x"=="z" (\n  echo b\n) & echo AFTER\necho END
A | A-r4 | caret-continued IF after & -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nver >nul & if "x"=="y" ^\ngoto :eof\necho [!A!]
A | A-r5 | IF block after & -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nver >nul & if "x"=="y" (\n  goto :eof\n)\necho [!A!]
A | A-r6 | parenthesized one-line IF GOTO -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\n(if "x"=="y" goto :eof)\necho [!A!]
A | A-r7 | ENDLOCAL in THEN, ELSE closed on its exit line -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nif "x"=="x" (\n  endlocal\n) else (echo leaving\n  exit /b 1)\necho [!A!]
A | A-r8 | THEN closed on its echo line -> prints bye, [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nif "x"=="x" (\n  endlocal\n  echo bye) else (\n  exit /b 1\n)\necho [!A!]
A | A-r9 | SETLOCAL DISABLEDELAYEDEXPANSION then !A! on the same line -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nif "x"=="x" setlocal disabledelayedexpansion & echo [!A!]
A | A-r10 | label called through a FOR variable -> prints [1], [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\ncall :show\nendlocal\nfor %%L in (:show) do call %%L\nexit /b\n:show\necho [!A!]\nexit /b
A | A-r11 | caret-continued empty FOR -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nfor %%i in () do ^\ngoto :eof\necho [!A!]
A | A-r12 | FOR /F command continued by caret, no match -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nfor /f "delims=" %%F in ('ver ^\n  ^| find "zzzz"') do (\n  goto :eof\n)\necho [!A!]
A | A-r13 | GOTO from a variable -> prints [1], [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nset "go=goto :show"\ncall :show\nendlocal\n%go%\nexit /b\n:show\necho [!A!]\nexit /b
B | B-o13 | a comma after an IF condition is a delimiter before the command -> prints S003PROBE=1 | @if exist %~f0, set S003PROBE=1\n@set S003PROBE
B | B-o14 | a semicolon after an IF comparison -> prints S003PROBE=1 | @if 1==1; set S003PROBE=1\n@set S003PROBE
B | B-o15 | a comma after & before a command -> prints S003PROBE=1 | @cd . & , set S003PROBE=1\n@set S003PROBE
B | B-o16 | the ) closing a FOR /F set ends its command string, so ^& after DO is text -> prints [Microsoft Windows …] & set S003PROBE=1, then "Environment variable S003PROBE not defined" | @for /f "delims=" %%a in ('ver') do @echo [%%a] ^& set S003PROBE=1\n@set S003PROBE
B | B-o17 | a ) closing a block ends a cmd /c inside it, so a later ^& is text -> prints A, then "Environment variable S003PROBE not defined" | @(cmd /c echo A) ^& set S003PROBE=1\n@set S003PROBE
B | B-o18 | cmd /r is cmd /c -> prints S003PROBE=1 | @cmd /r set S003PROBE=1 ^& set S003PROBE
B | B-o19 | START of an external program does not split on ^& -> find.exe reports missing files "&", "echo", "SPLIT", and no SPLIT line | @start "" /b /wait find.exe /c "x" nul ^& echo SPLIT <nul
B | B-o20 | CALL of an internal command with ^& -> prints S003PROBE=1 only if CALL splits | @call echo A ^& set S003PROBE=1\n@set S003PROBE
B | B-o21 | caret continuation escapes the next line's caret, so its & is live -> prints A, then S003PROBE=1 | @cmd /c echo A ^\n^& set S003PROBE=1\n@set S003PROBE
B | B-o22 | ^& inside a quoted cmd /c string stays text in the child -> prints no S003PROBE line | @cmd /c "set S003PROBE=1 ^& set S003PROBE"
A | A-q1 | FOR then IF block closed on its exit line -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nfor %%i in (1) do if "x"=="y" (echo bye\n  exit /b 1)\necho [!A!]
A | A-q2 | empty FOR with a block closed on its exit line -> prints [!A!] | @echo off\nsetlocal enabledelayedexpansion\nset A=1\nendlocal\nfor %%i in () do (echo bye\n  exit /b 1)\necho [!A!]
A | A-q3a | comma after GOTO -> END alone if a delimiter | @echo off\ngoto,end\necho FELL\n:end\necho END
A | A-q3b | semicolon after GOTO -> END alone if a delimiter | @echo off\ngoto;end\necho FELL\n:end\necho END
A | A-q3c | equals sign after GOTO -> END alone if a delimiter | @echo off\ngoto=end\necho FELL\n:end\necho END
A | A-q4 | jump into a THEN block -> in, [1] if ELSE skipped; [!A!] if it runs | @echo off\nsetlocal enabledelayedexpansion\nset A=1\ngoto :inside\nif "x"=="x" (\n:inside\n  echo in\n) else (\n  endlocal\n)\necho [!A!]
A | A-q5 | jump into a block -> whether ") & cmd" runs | @echo off\ngoto :inside\nif "x"=="y" (\n:inside\n  echo in\n) & echo AFTER\necho END
A | A-q6 | "rem )" inside a block -> IN, END if it does not close the block | @echo off\nif "x"=="x" (\n  rem )\n  echo IN\n)\necho END
A | A-r13b | GOTO from a variable set before SETLOCAL -> prints [1], [!A!] | @echo off\nset "go=goto :show"\nsetlocal enabledelayedexpansion\nset A=1\ncall :show\nendlocal\n%go%\nexit /b\n:show\necho [!A!]\nexit /b
