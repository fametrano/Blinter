# Oracle samples, round r17 (2026-11-04).
# Format: BRANCH | ID | WHAT IT PROBES -> OUTPUT THAT CONFIRMS IT | SCRIPT
# SCRIPT is one batch file; "\n" separates its lines (written with CRLF). Run as a .bat file.
X | Q1 | start with quoted full cmd.exe path, cmd /c, three carets -> CHILD-SPLIT on its own line if the child splits | @echo off\nstart "" /b /wait "C:\\Windows\\System32\\cmd.exe" /c echo A ^^^& echo CHILD-SPLIT
X | Q2 | start with quoted full path, cmd /c cmd /c, three carets -> GRANDCHILD-SPLIT on its own line if the grandchild splits | @echo off\nstart "" /b /wait "C:\\Windows\\System32\\cmd.exe" /c cmd /c echo A ^^^& echo GRANDCHILD-SPLIT
X | Q3 | start with quoted full path, cmd /c, one caret -> SPLIT1 on its own line if the child splits | @echo off\nstart "" /b /wait "C:\\Windows\\System32\\cmd.exe" /c echo A ^& echo SPLIT1
X | Q4 | start with a non-empty title, cmd /c, three carets -> TITLED on its own line if the child splits | @echo off\nstart "title" /b /wait cmd /c echo A ^^^& echo TITLED
X | C1 | start cmd without /c, caret ampersand, stdin from nul -> AFTER printed or not, then done | @echo off\nstart /b /wait cmd ^& echo AFTER <nul\necho done
X | C2 | start cmd without /c, words then caret ampersand, stdin from nul -> AFTER2 printed or not, then done | @echo off\nstart /b /wait cmd echo X ^& echo AFTER2 <nul\necho done
