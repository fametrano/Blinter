# Oracle samples, round r16 (2026-11-04).
# Format: BRANCH | ID | WHAT IT PROBES -> OUTPUT THAT CONFIRMS IT | SCRIPT
# SCRIPT is one batch file; "\n" separates its lines (written with CRLF). Run as a .bat file.
X | S1 | start /b /wait cmd /c with three carets before ampersand -> CHILD-SPLIT on its own line if the child splits | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\nstart "" /b /wait cmd /c echo A ^^^& echo CHILD-SPLIT
X | S2 | start /b /wait cmd /c with one caret before ampersand -> SPLIT1 on its own line if the child splits | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\nstart "" /b /wait cmd /c echo A ^& echo SPLIT1
X | S3 | start /b /wait cmd /c with three carets before the pipe -> no dir listing and find output if the child pipes | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\nstart "" /b /wait cmd /c dir /b ^^^| find "x"\necho done
X | S4 | start /b /wait cmd /c three carets, child SET into a file -> R16=1 typed if the child ran SET | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\nstart /b /wait cmd /c echo A ^^^& set R16=1 ^^^& set R16 ^> "%TEMP%\r16a.txt"\ntype "%TEMP%\r16a.txt"
X | S5 | start /b /wait cmd /c one caret, child SET into a file -> R16=1 typed if the child ran SET | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\nstart /b /wait cmd /c echo A ^& set R16=1 ^& set R16 ^> "%TEMP%\r16b.txt"\ntype "%TEMP%\r16b.txt"
X | S6 | start /b /wait cmd /c with seven carets before ampersand -> DEEP on its own line if the child splits | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\nstart /b /wait cmd /c echo A ^^^^^^^& echo DEEP
X | S7 | control without START, cmd /c with three carets -> NOSTART on its own line if the child splits | @echo off\ndel "%TEMP%\\r16*.txt" 2>nul\ncmd /c echo A ^^^& echo NOSTART
