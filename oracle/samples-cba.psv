# Oracle samples, round r14 (2026-11-03).
# Format: BRANCH | ID | WHAT IT PROBES -> OUTPUT THAT CONFIRMS IT | SCRIPT
# SCRIPT is one batch file; "\n" separates its lines (written with CRLF). Run as a .bat file.
X | X1 | >&2 before CALL -> R=1 if :sub ran | @echo off\n>&2 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X2 | echo with >&2 then call text -> R=1 if :sub ran | @echo off\necho see >&2 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X3 | echo with 2>&1 then call text -> R=1 if :sub ran | @echo off\necho see 2>&1 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X4 | echo with <&2 then call text -> R=1 if :sub ran | @echo off\necho see <&2 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X5 | echo with 1>&2 then goto text; BACK shows fall-through -> R=1 if :sub ran | @echo off\necho see 1>&2 goto sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X6 | escaped > then & call -> R=1 if :sub ran | @echo off\necho a ^>& call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X7 | double caret > then & call -> R=1 if :sub ran | @echo off\necho a ^^>& call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X8 | expanded 2 before >&1 then call text -> R=1 if :sub ran | @echo off\nset v=2\necho a %v%>&1 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X9 | undefined v before >&1 then call text -> R=1 if :sub ran | @echo off\necho a %v%>&1 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
X | X10 | echo with 3>&1 then call text -> R=1 if :sub ran | @echo off\necho see 3>&1 call :sub\necho BACK\nset R\nexit /b\n:sub\nset R=1\nexit /b
